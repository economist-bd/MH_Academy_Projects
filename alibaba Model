
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alibaba Cloud Model Studio</title>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: #000;
    color: #fff;
    overflow-x: hidden;
  }

  /* Navigation */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    height: 56px;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
  }

  .nav-logo-icon {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: linear-gradient(135deg, #6c5ce7, #a29bfe);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-links a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: #fff;
  }

  .nav-start-free {
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .nav-start-free:hover {
    opacity: 0.8;
  }

  /* Hero Section */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 40px 80px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 50%, rgba(100, 100, 120, 0.15) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 50%, rgba(60, 40, 180, 0.2) 0%, transparent 50%);
    z-index: 0;
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 800"><defs><linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:%23667;stop-opacity:0.1"/><stop offset="100%" style="stop-color:%234020c0;stop-opacity:0.05"/></linearGradient></defs><rect fill="url(%23g)" width="1440" height="800"/></svg>') center/cover;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 24px;
  }

  .hero-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
  }

  .hero-badge a {
    color: #a29bfe;
    text-decoration: none;
    font-weight: 500;
  }

  .hero h1 {
    font-size: 64px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -1px;
    margin-bottom: 20px;
    background: linear-gradient(180deg, #fff 0%, rgba(255,255,255,0.8) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero p {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.6;
    margin-bottom: 36px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    display: inline-block;
    padding: 12px 28px;
    border-radius: 100px;
    background: linear-gradient(135deg, #6c5ce7, #5a4bd1);
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s;
    border: none;
    cursor: pointer;
  }

  .hero-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 30px rgba(108, 92, 231, 0.4);
  }

  /* Models Section */
  .models-section {
    padding: 80px 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    text-align: center;
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 32px;
  }

  .model-tabs {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .model-tab {
    padding: 8px 20px;
    border-radius: 100px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .model-tab.active {
    background: rgba(108, 92, 231, 0.15);
    border-color: rgba(108, 92, 231, 0.4);
    color: #fff;
  }

  .model-tab:hover:not(.active) {
    border-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.8);
  }

  .model-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .model-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 24px;
    transition: all 0.3s;
    cursor: pointer;
  }

  .model-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-2px);
  }

  .model-card h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .model-card .model-series {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .model-card .model-series::before {
    content: '◆';
    font-size: 8px;
    color: rgba(108, 92, 231, 0.6);
  }

  .model-card p {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.6;
  }

  .more-models-btn {
    display: block;
    margin: 0 auto;
    padding: 10px 24px;
    border-radius: 100px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .more-models-btn:hover {
    border-color: rgba(255, 255, 255, 0.3);
    color: #fff;
  }

  /* Why Model Studio */
  .why-section {
    padding: 80px 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    overflow: hidden;
  }

  .why-left {
    display: flex;
    flex-direction: column;
  }

  .why-item {
    padding: 32px;
    background: rgba(0, 0, 0, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    cursor: pointer;
    transition: background 0.2s;
  }

  .why-item:first-child {
    background: rgba(108, 92, 231, 0.08);
  }

  .why-item:hover {
    background: rgba(108, 92, 231, 0.05);
  }

  .why-item-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(108, 92, 231, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    font-size: 16px;
  }

  .why-item h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .why-item:first-child h3 {
    color: #a29bfe;
  }

  .why-item p {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.6;
  }

  .why-right {
    background: rgba(0, 0, 0, 0.6);
    padding: 32px;
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    gap: 8px;
    justify-content: center;
  }

  .model-tag {
    padding: 8px 16px;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    transition: all 0.2s;
  }

  .model-tag.highlight {
    background: rgba(108, 92, 231, 0.15);
    border-color: rgba(108, 92, 231, 0.3);
    color: #fff;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
  }

  .model-tag.highlight .tag-icon {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: linear-gradient(135deg, #6c5ce7, #a29bfe);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }

  /* Latest Updates */
  .updates-section {
    padding: 80px 40px;
    max-width: 900px;
    margin: 0 auto;
  }

  .updates-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .update-item {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    align-items: flex-start;
  }

  .update-date {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.3);
    min-width: 80px;
    flex-shrink: 0;
    padding-top: 2px;
  }

  .update-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #6c5ce7;
    margin-top: 6px;
    flex-shrink: 0;
  }

  .update-content {
    flex: 1;
  }

  .update-label {
    font-size: 12px;
    color: #a29bfe;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .update-title {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
  }

  .update-desc {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.4);
    line-height: 1.6;
    margin-top: 4px;
  }

  .update-desc a {
    color: #a29bfe;
    text-decoration: none;
  }

  /* Get Started */
  .getstarted-section {
    padding: 80px 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .getstarted-subtitle {
    text-align: center;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 40px;
  }

  .getstarted-cta {
    display: block;
    margin: 0 auto 60px;
    padding: 12px 28px;
    border-radius: 100px;
    background: linear-gradient(135deg, #6c5ce7, #5a4bd1);
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.3s;
  }

  .getstarted-cta:hover {
    box-shadow: 0 8px 30px rgba(108, 92, 231, 0.4);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    overflow: hidden;
  }

  .step-left {
    display: flex;
    flex-direction: column;
  }

  .step-item {
    padding: 32px;
    background: rgba(0, 0, 0, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    cursor: pointer;
    transition: background 0.2s;
  }

  .step-item:first-child {
    background: rgba(108, 92, 231, 0.08);
  }

  .step-item h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .step-item:first-child h3 {
    color: #a29bfe;
  }

  .step-icon {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .step-icon-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.3);
  }

  .step-icon-dot.active {
    background: #a29bfe;
  }

  .step-right {
    background: rgba(0, 0, 0, 0.6);
    padding: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-screenshot {
    width: 100%;
    max-width: 500px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .screenshot-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
  }

  .screenshot-header .btn-create {
    padding: 4px 12px;
    border-radius: 4px;
    background: #6c5ce7;
    color: #fff;
    font-size: 11px;
    border: none;
    cursor: pointer;
  }

  .screenshot-body {
    padding: 16px;
  }

  .screenshot-table {
    width: 100%;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
  }

  .screenshot-table th {
    text-align: left;
    padding: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.3);
    font-weight: 500;
  }

  .screenshot-table td {
    padding: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  }

  .screenshot-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-group label {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
  }

  .form-group input, .form-group select, .form-group textarea {
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    outline: none;
  }

  .form-group textarea {
    height: 60px;
    resize: none;
  }

  .form-ok-btn {
    align-self: flex-start;
    padding: 6px 20px;
    border-radius: 4px;
    background: #6c5ce7;
    color: #fff;
    font-size: 11px;
    border: none;
    cursor: pointer;
  }

  /* Empowering Industries */
  .industries-section {
    padding: 80px 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .industries-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .industry-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 28px;
    transition: all 0.3s;
  }

  .industry-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
  }

  .industry-quote {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.15);
    margin-bottom: 12px;
    line-height: 1;
  }

  .industry-card p {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .industry-person {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(108, 92, 231, 0.15), rgba(108, 92, 231, 0.05));
    position: relative;
    overflow: hidden;
  }

  .industry-person::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 40%;
    background: linear-gradient(135deg, transparent 0%, rgba(108, 92, 231, 0.1) 100%);
    clip-path: polygon(30% 0, 100% 0, 100% 100%, 0% 100%);
  }

  .person-info {
    flex: 1;
    z-index: 1;
  }

  .person-name {
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .person-title {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 8px;
  }

  .person-learn {
    font-size: 12px;
    color: #a29bfe;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .person-photo {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    object-fit: cover;
    z-index: 1;
  }

  /* CTA Section */
  .cta-section {
    padding: 100px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-section::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(ellipse, rgba(108, 92, 231, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-icon {
    width: 40px;
    height: 40px;
    margin: 0 auto 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cta-icon svg {
    width: 32px;
    height: 32px;
  }

  .cta-section h2 {
    font-size: 36px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .cta-section p {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 32px;
  }

  .cta-btn {
    display: inline-block;
    padding: 12px 32px;
    border-radius: 100px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s;
  }

  .cta-btn:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.05);
  }

  /* Footer */
  footer {
    padding: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    text-align: center;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .footer-links a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    font-size: 13px;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: #fff;
  }

  .footer-copy {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.3);
  }

  /* Floating buttons */
  .floating-btns {
    position: fixed;
    right: 24px;
    bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 999;
  }

  .floating-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
  }

  .floating-btn.chat {
    background: linear-gradient(135deg, #6c5ce7, #a29bfe);
    color: #fff;
  }

  .floating-btn.star {
    background: linear-gradient(135deg, #6c5ce7, #a29bfe);
    color: #fff;
  }

  .floating-btn:hover {
    transform: scale(1.1);
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
  }

  /* Animations */
  .fade-in {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .model-cards {
      grid-template-columns: repeat(2, 1fr);
    }
    .industries-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 36px;
    }
    .model-cards {
      grid-template-columns: 1fr;
    }
    .why-grid, .steps-grid {
      grid-template-columns: 1fr;
    }
    nav {
      padding: 0 20px;
    }
    .nav-links {
      display: none;
    }
  }
</style>
</head>
<body>

<!-- Navigation -->
<nav>
  <a href="#" class="nav-logo">
    <div class="nav-logo-icon">☁</div>
    <span>Alibaba Cloud<br>Model Studio</span>
  </a>
  <div class="nav-links">
    <a href="#models">Models</a>
    <a href="#docs">Docs</a>
    <a href="#api">API Guide</a>
  </div>
  <a href="#" class="nav-start-free">Start Free</a>
</nav>

<!-- Hero Section -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-content">
    <div class="hero-badge">
      <span class="hero-badge-dot"></span>
